import aktual.budget.model.CategoryId;

CREATE TABLE IF NOT EXISTS category_mapping(
  id TEXT AS CategoryId PRIMARY KEY,
  transferId TEXT AS CategoryId
);

insert:
  INSERT OR REPLACE
    INTO category_mapping(id, transferId)
    VALUES (?, ?);

-- packages/loot-core/src/server/db/index.ts deleteCategory()
mappedTo: SELECT id FROM category_mapping WHERE transferId = ?;
